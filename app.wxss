/* 全局样式 —— 国风·茶姬配色（墨绿 + 米白 + 描金），底色走薄荷绿到米黄的渐变 */
page {
  /* 设计变量 */
  --brand: #14493C;          /* 墨绿 主色 */
  --brand-deep: #0C3329;     /* 深墨绿 */
  --brand-soft: #2E6F5E;     /* 浅墨绿 */
  --gold: #C3A15F;           /* 描金 强调 */
  --gold-deep: #A5854A;
  --gold-mist: rgba(195, 161, 95, 0.28);
  --cream: #F4EFE3;          /* 米白 页面底色 */
  --paper: #FFFDF7;          /* 卡纸白 */
  --ink: #2B2A26;            /* 墨色 正文 */
  --ink-soft: #6D6A60;       /* 次级文字 */
  --ink-mute: #9E9B90;       /* 弱文字 */
  --brick: #A8453B;          /* 朱砂 警示 */
  --mist: #E3EFDE;           /* 薄荷 渐变起点 */
  --sand: #F7F0DE;           /* 米黄 渐变终点 */
  --pill-mint: #D7EADC;      /* 胶囊导航 未选中 */
  --pill-cream: #ECE4C7;     /* 胶囊导航 选中 */

  background-color: var(--cream);
  background-image: linear-gradient(178deg, var(--mist) 0%, #F0EFE3 46%, var(--sand) 100%);
  background-attachment: fixed;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  color: var(--ink);
}

/* 容器 */
.container {
  padding: 24rpx;
  box-sizing: border-box;
}

/* 卡片 —— 仿茶笺：纸白渐变底 + 细金边 */
.card {
  background: linear-gradient(160deg, var(--paper) 0%, #FBF6E9 100%);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--gold-mist);
  box-shadow: 0 6rpx 24rpx rgba(20, 73, 60, 0.08);
  box-sizing: border-box;
}

/* 按钮 */
.btn-primary {
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-deep) 100%);
  color: #F7F2E6;
  border: none;
  border-radius: 8rpx;
  padding: 22rpx 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 4rpx;
  box-shadow: 0 6rpx 18rpx rgba(20, 73, 60, 0.22);
}

.btn-primary::after {
  border: none;
}

.btn-primary[disabled] {
  background: linear-gradient(135deg, #6F8A80, #5C766C);
  color: #E6E1D5;
}

.btn-outline {
  background: var(--paper);
  color: var(--brand);
  border: 2rpx solid var(--gold);
  border-radius: 8rpx;
  padding: 20rpx 46rpx;
  font-size: 30rpx;
  letter-spacing: 4rpx;
}

.btn-outline::after {
  border: none;
}

/* 标签 —— 国风方印，直角略带锋 */
.tag {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
  letter-spacing: 1rpx;
  margin-right: 10rpx;
}

.tag-success {
  background: rgba(20, 73, 60, 0.10);
  color: var(--brand);
  border: 1rpx solid rgba(20, 73, 60, 0.22);
}

.tag-warning {
  background: rgba(195, 161, 95, 0.16);
  color: var(--gold-deep);
  border: 1rpx solid rgba(195, 161, 95, 0.40);
}

.tag-info {
  background: rgba(46, 111, 94, 0.10);
  color: var(--brand-soft);
  border: 1rpx solid rgba(46, 111, 94, 0.24);
}

.tag-danger {
  background: rgba(168, 69, 59, 0.10);
  color: var(--brick);
  border: 1rpx solid rgba(168, 69, 59, 0.26);
}

/* 区块标题 —— 宋体 + 左侧金条 */
.section-title {
  position: relative;
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--brand);
  letter-spacing: 2rpx;
  padding-left: 20rpx;
  display: block;
  margin-bottom: 20rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 6rpx;
  bottom: 6rpx;
  width: 6rpx;
  background: linear-gradient(180deg, var(--gold), var(--gold-deep));
  border-radius: 3rpx;
}

.section-content {
  font-size: 26rpx;
  color: var(--ink-soft);
  line-height: 1.8;
}

/* 金色分隔线 */
.divider-gold {
  height: 1rpx;
  background: linear-gradient(90deg, transparent, var(--gold-mist), transparent);
  margin: 24rpx 0;
}

/* 表单 */
.form-item {
  margin-bottom: 28rpx;
}

.form-label {
  font-size: 28rpx;
  color: var(--ink);
  display: block;
  margin-bottom: 12rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.form-input,
.form-value {
  font-size: 28rpx;
  color: var(--ink);
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--gold-mist);
}

.form-textarea {
  font-size: 28rpx;
  width: 100%;
  height: 160rpx;
  padding: 20rpx;
  background: rgba(244, 239, 227, 0.55);
  border: 1rpx solid var(--gold-mist);
  border-radius: 8rpx;
  box-sizing: border-box;
}

/* 胶囊式页面导航 —— 统一供各列表页复用，直接浮在渐变底色上，不再套纸框 */
.filter-bar {
  display: flex;
  align-items: center;
  background: transparent;
  border: none;
  border-radius: 0;
  padding: 4rpx 0 20rpx;
  margin-bottom: 8rpx;
  overflow-x: auto;
}

.filter-item {
  padding: 14rpx 34rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--brand-soft);
  margin-right: 16rpx;
  white-space: nowrap;
  /* 胶囊不许被压扁：超出宽度时由 .filter-bar 横向滚动 */
  flex-shrink: 0;
  background: var(--pill-mint);
  letter-spacing: 2rpx;
  box-shadow: 0 4rpx 14rpx rgba(20, 73, 60, 0.10);
  transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
}

.filter-item.active {
  background: var(--pill-cream);
  color: var(--brand);
  font-weight: 600;
  transform: translateY(-3rpx);
  box-shadow: 0 8rpx 20rpx rgba(195, 161, 95, 0.30), inset 0 0 0 1rpx rgba(195, 161, 95, 0.40);
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 100rpx 0;
  color: var(--ink-mute);
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
  display: block;
  opacity: 0.75;
}

/* 加载 */
.loading {
  text-align: center;
  padding: 40rpx;
  color: var(--ink-mute);
  font-size: 24rpx;
  letter-spacing: 2rpx;
}
