/* 区域筛选组件（区域划分需求 §3.1），风格沿用 app.wxss 品牌变量 */
.rp-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 0;
  margin-bottom: 6rpx;
}

.rp-locate {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(195, 161, 95, 0.12);
  font-size: 30rpx;
  flex-shrink: 0;
}

.rp-locating {
  opacity: 0.5;
}

.rp-current {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 22rpx;
  border-radius: 32rpx;
  background: rgba(195, 161, 95, 0.08);
  border: 1rpx solid rgba(195, 161, 95, 0.25);
}

.rp-active {
  border-color: var(--brand, #8a6d3b);
}

.rp-label {
  font-size: 26rpx;
  color: var(--ink, #3a3a3a);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rp-caret {
  font-size: 20rpx;
  color: var(--ink-mute, #9a8f7f);
}

.rp-all {
  font-size: 26rpx;
  color: var(--brand, #8a6d3b);
  padding: 0 8rpx;
  flex-shrink: 0;
}

/* 面板 */
.rp-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.rp-panel {
  width: 100%;
  max-height: 72vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 30rpx 30rpx calc(30rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.rp-panel-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.rp-panel-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink, #3a3a3a);
}

.rp-panel-close {
  font-size: 30rpx;
  color: var(--ink-mute, #9a8f7f);
  padding: 8rpx;
}

.rp-group-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.rp-group-title {
  font-size: 24rpx;
  color: var(--ink-mute, #9a8f7f);
  margin: 26rpx 0 14rpx;
}

.rp-whole-link {
  font-size: 24rpx;
  color: var(--brand, #8a6d3b);
}

.rp-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.rp-chip {
  padding: 14rpx 26rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  background: #f6f3ec;
  color: var(--ink, #3a3a3a);
  border: 1rpx solid transparent;
}

.rp-chip-active {
  background: rgba(195, 161, 95, 0.16);
  border-color: var(--brand, #8a6d3b);
  color: var(--brand, #8a6d3b);
  font-weight: 600;
}

.rp-province-link {
  margin-top: 30rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--brand, #8a6d3b);
}
