# Spring Boot 应用环境变量配置模板
# 复制为 app.env 并填写实际值
# 注意：此文件包含敏感信息，不要提交到 Git

# ========================================
# 微信小程序配置
# ========================================
# 小程序 AppID（从微信公众平台获取）
WECHAT_APPID=wx3f05ea02cf194e9a

# 小程序 AppSecret（从微信公众平台获取，妥善保管）
WECHAT_SECRET=your_wechat_app_secret_here

# ========================================
# 腾讯位置服务配置
# ========================================
# 腾讯地图 WebAPI Key（从 lbs.qq.com 申请）
TENCENT_MAP_KEY=your_tencent_map_key_here

# ========================================
# 微信虚拟支付配置
# ========================================
# OfferID（从微信公众平台虚拟支付页面获取）
XPAY_OFFER_ID=1450691900

# AppKey（从微信公众平台虚拟支付页面获取，妥善保管）
XPAY_APP_KEY=your_xpay_app_key_here

# 推送 Token（自定义字符串，需与微信公众平台配置一致）
XPAY_PUSH_TOKEN=straycat2026payczone

# ========================================
# 内容安全检测配置（可选）
# ========================================
# msgSecCheck 是否启用（本地开发可设为 false，生产环境必须 true）
MSG_SEC_CHECK_ENABLED=true

# msgSecCheck 严格模式（true: review 和接口异常也拦截；false: 只拦截 risky）
MSG_SEC_CHECK_STRICT=false

# ========================================
# 订阅消息配置（可选）
# ========================================
# 订阅消息状态：trial（体验版）/ formal（正式版）/ developer（开发版）
WX_SUBSCRIBE_STATE=formal

# 各模板 ID（从微信公众平台订阅消息页面获取，留空则只写站内消息）
WX_TPL_TASK_ACCEPTED=
WX_TPL_RECORD_APPROVED=
WX_TPL_RECORD_REJECTED=
WX_TPL_RECORD_SUBMITTED=
WX_TPL_ADOPTION_NEW=
WX_TPL_ADOPTION_APPROVED=
WX_TPL_ADOPTION_REJECTED=
WX_TPL_FOLLOW_UP_DUE=
WX_TPL_RECORD_PENDING=

# ========================================
# 花纹识别服务配置（SIT/生产环境不同）
# ========================================
# SIT 环境：http://recognizer:8000（Docker 内部网络）
# 本地测试：http://localhost:8002
# 生产环境：http://recognizer:8000
RECOGNIZER_BASE_URL=http://recognizer:8000

# 匹配阈值（0-1），相似度 >= 此值认为匹配成功
RECOGNIZER_MATCH_THRESHOLD=0.85

# 人工确认阈值下限，相似度在此值和 match_threshold 之间需要人工确认
RECOGNIZER_MANUAL_THRESHOLD=0.70

# ========================================
# 其他配置（可选）
# ========================================
# 文件上传路径（容器内路径）
FILE_UPLOAD_PATH=/opt/stray-cat/uploads

# 日志级别（DEBUG/INFO/WARN/ERROR）
LOG_LEVEL=INFO
