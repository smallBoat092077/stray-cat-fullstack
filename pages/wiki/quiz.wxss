.quiz-page {
  padding-bottom: 60rpx;
}

.between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.quiz-label {
  font-size: 26rpx;
  color: var(--ink-soft);
}

.progress {
  height: 10rpx;
  background: var(--mist);
  border-radius: 999rpx;
  overflow: hidden;
  margin: 20rpx 0 40rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--gold-deep), var(--gold));
  border-radius: 999rpx;
  transition: width 0.2s ease;
}

.question {
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  font-size: 36rpx;
  color: var(--brand);
  line-height: 1.7;
  margin-bottom: 36rpx;
}

.options {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.option {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 26rpx;
  background: var(--paper);
  border: 1rpx solid var(--gold-mist);
  border-radius: 14rpx;
}

.option.active {
  background: var(--mist);
  border-color: var(--brand);
}

.option-letter {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  border-radius: 50%;
  border: 1rpx solid var(--gold);
  color: var(--gold-deep);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.option.active .option-letter {
  background: var(--brand);
  border-color: var(--brand);
  color: #FFFDF7;
}

.option-text {
  flex: 1;
  font-size: 27rpx;
  color: var(--ink);
  line-height: 1.5;
}

.nav-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 48rpx;
}

.nav-btn {
  margin: 0;
  padding: 18rpx 36rpx;
  font-size: 28rpx;
  min-width: 200rpx;
}

.nav-placeholder {
  width: 200rpx;
}

.tip-box {
  margin-top: 48rpx;
  padding: 20rpx 22rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #7B6637;
  background: #FBF4E4;
  border: 1rpx dashed var(--gold-mist);
  border-radius: 12rpx;
}

.error-tip {
  text-align: center;
  padding: 120rpx 0;
  font-size: 26rpx;
  color: var(--brick);
}
