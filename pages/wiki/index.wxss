.wiki-page {
  padding-bottom: 60rpx;
}

.wiki-hero {
  position: relative;
  overflow: hidden;
  padding: 36rpx 32rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, var(--brand), var(--brand-soft));
  margin-bottom: 20rpx;
}

.hero-deco {
  position: absolute;
  right: -40rpx;
  bottom: -90rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(227, 239, 222, 0.25);
  box-shadow: 0 0 0 30rpx rgba(227, 239, 222, 0.06), 0 0 0 70rpx rgba(227, 239, 222, 0.05);
}

.hero-title {
  position: relative;
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  font-size: 38rpx;
  font-weight: 600;
  color: #FFFDF7;
  letter-spacing: 2rpx;
}

.hero-sub {
  position: relative;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #D8E7D8;
}

.hero-btn {
  position: relative;
  display: inline-block;
  margin-top: 28rpx;
  padding: 16rpx 36rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #23382F;
  background: var(--gold);
  border: none;
  border-radius: 999rpx;
  line-height: 1.4;
}

.hero-btn::after {
  border: none;
}

.my-quiz-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 28rpx;
  margin-bottom: 24rpx;
  font-size: 26rpx;
  color: var(--brand);
  background: var(--paper);
  border: 1rpx solid var(--gold-mist);
  border-radius: 14rpx;
}

.entry-arrow {
  font-size: 32rpx;
  color: var(--gold-deep);
}

.between {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.section-head {
  margin-top: 8rpx;
}

.muted {
  font-size: 22rpx;
  color: var(--ink-mute);
}

.cats {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 28rpx;
}

.cat-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 18rpx;
  font-size: 24rpx;
  color: var(--brand);
  background: var(--paper);
  border: 1rpx solid var(--gold-mist);
  border-radius: 12rpx;
}

.cat-item.active {
  color: #FFFDF7;
  background: var(--brand);
  border-color: var(--brand);
}

.cat-initial {
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  font-size: 22rpx;
  opacity: 0.85;
}

.cat-count {
  font-size: 20rpx;
  opacity: 0.7;
}

.art-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx;
  margin-bottom: 16rpx;
  background: var(--paper);
  border: 1rpx solid var(--gold-mist);
  border-radius: 14rpx;
}

.art-img {
  width: 112rpx;
  height: 112rpx;
  flex-shrink: 0;
  border-radius: 10rpx;
  background: var(--sand);
}

.art-img-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  font-size: 44rpx;
  color: var(--gold-deep);
}

.art-body {
  flex: 1;
  min-width: 0;
}

.art-title {
  font-size: 27rpx;
  font-weight: 500;
  color: var(--ink);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.art-meta {
  margin-top: 10rpx;
  font-size: 21rpx;
  color: var(--ink-mute);
}

.tip-box {
  margin-top: 32rpx;
  padding: 22rpx 24rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #7B6637;
  background: #FBF4E4;
  border: 1rpx dashed var(--gold-mist);
  border-radius: 12rpx;
}

.disclaimer-title {
  display: block;
  font-weight: 600;
  color: var(--ink-soft);
  margin-bottom: 6rpx;
}

.error-tip {
  text-align: center;
  padding: 60rpx 0;
  font-size: 26rpx;
  color: var(--brick);
}
