.container { padding: 20rpx; padding-bottom: 120rpx; }

.card { padding: 24rpx; }

.task-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.task-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.task-info-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.task-info-row:last-child { border-bottom: none; }

.label {
  font-size: 26rpx;
  color: #999;
}

.value {
  font-size: 26rpx;
  color: #333;
}

.amount {
  color: #FF6B6B;
  font-weight: 600;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}

.checkin-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.checkin-area button {
  width: 100%;
  margin-bottom: 20rpx;
}

.checkin-tips {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.checkin-tips text {
  font-size: 24rpx;
  color: #999;
}
