.container { padding: 24rpx; padding-bottom: 140rpx; }
.card { padding: 32rpx; }

.task-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--gold-mist);
}

.task-title {
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  font-size: 38rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
  color: var(--brand);
}

.task-info-row {
  display: flex;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(195, 161, 95, 0.16);
}

.task-info-row:last-child { border-bottom: none; }

.label {
  font-size: 26rpx;
  color: var(--ink-mute);
  letter-spacing: 2rpx;
}

.value {
  font-size: 26rpx;
  color: var(--ink);
}

.amount {
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  color: var(--gold-deep);
  font-weight: 600;
  font-size: 30rpx;
}

.checkin-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.status-text {
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--ink-soft);
}

.checkin-area button {
  width: 100%;
  margin-bottom: 20rpx;
}

.checkin-tips {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.checkin-tips text {
  font-size: 24rpx;
  color: var(--ink-mute);
}

.image-list { display: flex; flex-wrap: wrap; gap: 16rpx; width: 100%; }
.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 10rpx;
  overflow: hidden;
  border: 1rpx solid var(--gold-mist);
}
.image-item image { width: 100%; height: 100%; }
.image-remove {
  position: absolute;
  top: 0;
  right: 0;
  width: 48rpx;
  height: 48rpx;
  background: rgba(12, 51, 41, 0.72);
  color: #F7F2E6;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 10rpx 0 10rpx;
}
.image-add {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed var(--gold);
  border-radius: 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(195, 161, 95, 0.06);
}
.add-icon { font-size: 64rpx; color: var(--gold); line-height: 1; }
.add-text { font-size: 24rpx; color: var(--ink-mute); margin-top: 8rpx; letter-spacing: 1rpx; }

/* 识别相关样式 */
.recognize-banner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, rgba(195, 161, 95, 0.12), rgba(195, 161, 95, 0.06));
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--gold-mist);
}

.banner-icon {
  font-size: 40rpx;
}

.banner-text {
  font-size: 26rpx;
  color: var(--ink);
  letter-spacing: 1rpx;
}

.recognize-result {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--gold-mist);
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.result-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--brand);
}

.result-similarity {
  font-size: 24rpx;
  color: var(--gold-deep);
  font-weight: 600;
}

.match-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.match-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  background: rgba(195, 161, 95, 0.04);
  border-radius: 10rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.match-item.selected {
  border-color: var(--gold);
  background: rgba(195, 161, 95, 0.12);
}

.match-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.match-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.match-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.match-similarity {
  font-size: 22rpx;
  color: var(--gold-deep);
}

.match-location {
  font-size: 20rpx;
  color: var(--ink-mute);
}

.match-check {
  width: 48rpx;
  height: 48rpx;
  background: var(--gold);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
}

.recognize-actions {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.btn-small {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  border-radius: 8rpx;
  margin: 0;
}

.btn-warning {
  background: #FF9500;
  color: #fff;
}

.recognizing {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
  gap: 24rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--gold-mist);
  border-top-color: var(--gold);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: var(--ink-mute);
}
