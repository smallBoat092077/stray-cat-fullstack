.container { padding: 24rpx; padding-bottom: 140rpx; }
.card { padding: 32rpx; }

.task-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--gold-mist);
}

.task-title {
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  font-size: 38rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
  color: var(--brand);
}

.task-info-row {
  display: flex;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(195, 161, 95, 0.16);
}

.task-info-row:last-child { border-bottom: none; }

.label {
  font-size: 26rpx;
  color: var(--ink-mute);
  letter-spacing: 2rpx;
}

.value {
  font-size: 26rpx;
  color: var(--ink);
}

.amount {
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  color: var(--gold-deep);
  font-weight: 600;
  font-size: 30rpx;
}

.checkin-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.status-text {
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--ink-soft);
}

.checkin-area button {
  width: 100%;
  margin-bottom: 20rpx;
}

.checkin-tips {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.checkin-tips text {
  font-size: 24rpx;
  color: var(--ink-mute);
}

.image-list { display: flex; flex-wrap: wrap; gap: 16rpx; width: 100%; }
.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 10rpx;
  overflow: hidden;
  border: 1rpx solid var(--gold-mist);
}
.image-item image { width: 100%; height: 100%; }
.image-remove {
  position: absolute;
  top: 0;
  right: 0;
  width: 48rpx;
  height: 48rpx;
  background: rgba(12, 51, 41, 0.72);
  color: #F7F2E6;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 10rpx 0 10rpx;
}
.image-add {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed var(--gold);
  border-radius: 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(195, 161, 95, 0.06);
}
.add-icon { font-size: 64rpx; color: var(--gold); line-height: 1; }
.add-text { font-size: 24rpx; color: var(--ink-mute); margin-top: 8rpx; letter-spacing: 1rpx; }
