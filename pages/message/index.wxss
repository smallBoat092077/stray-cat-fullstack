.container {
  padding: 24rpx;
}

.item {
  margin-bottom: 20rpx;
  padding: 26rpx 24rpx;
  position: relative;
}

.item.unread {
  border-left: 6rpx solid var(--brand);
}

.item-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.item-title-wrap {
  display: flex;
  align-items: center;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--brick);
  margin-right: 10rpx;
}

.item-title {
  font-size: 30rpx;
  color: var(--ink);
  font-family: "Songti SC", serif;
  letter-spacing: 1rpx;
}

.item-time {
  font-size: 22rpx;
  color: var(--ink-mute);
}

.item-content {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--ink-mute);
}

.item-arrow {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--brand);
}

.empty {
  margin-top: 20rpx;
  padding: 60rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--ink-mute);
}

.loadmore {
  padding: 32rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--ink-mute);
}

/* 微信通知授权入口 */
.notify-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, var(--cream), var(--paper));
}

.notify-main {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.notify-title {
  font-size: 28rpx;
  color: var(--ink);
  font-family: "Songti SC", serif;
}

.notify-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--ink-mute);
}

.notify-action {
  flex: none;
  margin-left: 16rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  border: 1px solid var(--brand);
  font-size: 24rpx;
  color: var(--brand);
}

/* 没推开微信的原因，比正文更淡一层 */
.item-push {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--ink-mute);
  opacity: 0.8;
}
