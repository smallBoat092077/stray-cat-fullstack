.container {
  padding: 24rpx;
}

.item {
  margin-bottom: 20rpx;
  padding: 26rpx 24rpx;
  position: relative;
}

.item.unread {
  border-left: 6rpx solid var(--brand);
}

.item-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.item-title-wrap {
  display: flex;
  align-items: center;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--brick);
  margin-right: 10rpx;
}

.item-title {
  font-size: 30rpx;
  color: var(--ink);
  font-family: "Songti SC", serif;
  letter-spacing: 1rpx;
}

.item-time {
  font-size: 22rpx;
  color: var(--ink-mute);
}

.item-content {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--ink-mute);
}

.item-arrow {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--brand);
}

.empty {
  margin-top: 20rpx;
  padding: 60rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--ink-mute);
}

.loadmore {
  padding: 32rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--ink-mute);
}
