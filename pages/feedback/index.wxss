.form-card {
  padding: 32rpx 28rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--brand-deep, #14493C);
  margin-bottom: 20rpx;
}

.type-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.type-chip {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #6F6B60;
  background: #F2EDE0;
  border: 1rpx solid var(--gold-mist, #E3DCC8);
}

.type-chip.active {
  color: #F7F2E6;
  background: var(--brand, #14493C);
  border-color: var(--brand, #14493C);
}

.content-input {
  width: 100%;
  min-height: 200rpx;
  box-sizing: border-box;
  padding: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
  background: #FFFDF7;
  border: 1rpx solid var(--gold-mist, #E3DCC8);
  border-radius: 12rpx;
}

.input-placeholder {
  color: #B8B2A4;
}

.char-count {
  text-align: right;
  font-size: 22rpx;
  color: #9E9B90;
  margin: 8rpx 4rpx 20rpx;
}

.img-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.img-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.img-thumb {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  display: block;
}

.img-remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 28rpx;
  line-height: 40rpx;
  text-align: center;
}

.img-add {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed #C9C2B0;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #9E9B90;
}

.img-add-plus {
  font-size: 48rpx;
  line-height: 1;
}

.img-add-text {
  font-size: 22rpx;
  margin-top: 6rpx;
}

.submit-btn {
  width: 100%;
}

.submit-btn.disabled {
  opacity: 0.6;
}

.tips {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #9E9B90;
  text-align: center;
}

.mine-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 8rpx 4rpx 20rpx;
}

.mine-head .section-title {
  margin-bottom: 0;
}

.mine-count {
  font-size: 24rpx;
  color: #9E9B90;
}

.record-card {
  padding: 24rpx 28rpx;
}

.record-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.record-type {
  font-size: 24rpx;
  color: #6F8A80;
  background: #EAF1EC;
  border-radius: 6rpx;
  padding: 4rpx 14rpx;
}

.record-status {
  font-size: 24rpx;
}

.record-status.s0 {
  color: #C08A2D;
}

.record-status.s1 {
  color: #2E7D4F;
}

.record-status.s2 {
  color: #9E9B90;
}

.record-content {
  font-size: 28rpx;
  color: #3A362E;
  line-height: 1.6;
  word-break: break-all;
}

.record-imgs {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.record-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 10rpx;
  display: block;
}

.record-reply {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #EFF5F0;
  border-left: 6rpx solid var(--brand, #14493C);
  border-radius: 8rpx;
}

.reply-label {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--brand, #14493C);
  margin-bottom: 6rpx;
}

.reply-text {
  font-size: 26rpx;
  color: #3A362E;
  line-height: 1.6;
  word-break: break-all;
}

.record-time {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #B8B2A4;
}

.empty {
  padding: 80rpx 0;
  text-align: center;
}

.empty-text {
  font-size: 26rpx;
  color: #9E9B90;
}

.load-all {
  padding: 30rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #B8B2A4;
}
