.container {
  padding: 24rpx;
}

.cover {
  width: 100%;
  border-radius: 20rpx;
  border: 1rpx solid var(--gold-mist);
  display: block;
  margin-top: 8rpx;
}

.head {
  margin-top: 20rpx;
  padding: 30rpx;
  display: flex;
  flex-direction: column;
}

.name {
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  font-size: 38rpx;
  font-weight: 700;
  color: var(--brand-deep);
  letter-spacing: 2rpx;
}

.desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--ink-soft);
}

.ended-banner {
  margin-top: 20rpx;
  padding: 14rpx 20rpx;
  border-radius: 10rpx;
  background: var(--cream);
  font-size: 24rpx;
  color: var(--ink-mute);
}

.heat {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--gold);
  letter-spacing: 1rpx;
}

.section-title {
  display: block;
  margin: 30rpx 0 6rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--brand);
  letter-spacing: 2rpx;
}

.cat-item {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  padding: 20rpx;
}

.cat-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 14rpx;
  flex: none;
  background: var(--cream);
}

.cat-main {
  flex: 1;
  margin-left: 22rpx;
  display: flex;
  flex-direction: column;
}

.cat-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.tag {
  margin-top: 10rpx;
  align-self: flex-start;
  padding: 4rpx 14rpx;
  font-size: 20rpx;
  border-radius: 8rpx;
}

.tag-info {
  color: var(--ink-mute);
  background: var(--cream);
}

.tag-primary {
  color: var(--paper);
  background: var(--brand-soft);
}

.tag-warning {
  color: var(--paper);
  background: var(--brick);
}

.tag-success {
  color: var(--paper);
  background: var(--brand);
}

.cat-arrow {
  font-size: 36rpx;
  color: var(--ink-mute);
}

.actions {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.empty {
  margin-top: 30rpx;
  padding: 60rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-title {
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--brand-deep);
}

.empty-btn {
  margin-top: 30rpx;
}

.loadmore {
  margin-top: 40rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--ink-mute);
}
