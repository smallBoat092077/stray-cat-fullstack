<brand-nav back="{{true}}" />
<view class="container">

  <view class="loadmore" wx:if="{{loading}}">加载中...</view>

  <!-- 活动不存在 -->
  <view class="empty card" wx:if="{{!loading && notFound}}">
    <text class="empty-title">活动不存在或已下线</text>
    <button class="btn-primary empty-btn" bindtap="goCatList">看看猫咪</button>
  </view>

  <block wx:if="{{!loading && campaign}}">
    <!-- 封面 -->
    <image class="cover" src="{{campaign.coverUrl}}" mode="widthFix" wx:if="{{campaign.coverUrl}}" />

    <!-- 活动名与介绍 -->
    <view class="head card">
      <text class="name">{{campaign.name}}</text>
      <text class="desc" wx:if="{{campaign.description}}">{{campaign.description}}</text>
      <view class="ended-banner" wx:if="{{campaign.ended}}">
        <text>活动已结束，但守护还在继续</text>
      </view>
      <view class="heat" wx:if="{{campaign.pv > 0}}">
        <text>已有 {{campaign.pv}} 次访问 · 带来 {{campaign.newUsers}} 位新朋友</text>
      </view>
    </view>

    <!-- 本活动的猫咪 -->
    <view class="cats" wx:if="{{cats.length > 0}}">
      <text class="section-title">本活动的猫咪</text>
      <view class="cat-item card" wx:for="{{cats}}" wx:key="id" bindtap="goCat" data-id="{{item.id}}">
        <image class="cat-cover" src="{{item.coverImage}}" mode="aspectFill" />
        <view class="cat-main">
          <text class="cat-name">{{item.name}}</text>
          <text class="tag tag-{{item.lifeStatusClass}}">{{item.lifeStatusText}}</text>
        </view>
        <text class="cat-arrow">›</text>
      </view>
    </view>

    <!-- 双 CTA -->
    <view class="actions">
      <button class="btn-primary" open-type="share">分享给朋友</button>
      <button class="btn-outline" wx:if="{{canSubscribe && !campaign.ended}}"
              bindtap="onSubscribe" disabled="{{subscribing}}">
        {{subscribing ? '处理中' : '订阅活动提醒'}}
      </button>
    </view>
  </block>
</view>
