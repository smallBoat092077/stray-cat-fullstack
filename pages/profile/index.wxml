<view class="container">
  <!-- 用户信息 -->
  <view class="user-card card">
    <view class="user-header">
      <image class="user-avatar" src="{{userInfo.avatarUrl || '/images/default-avatar.png'}}" />
      <view class="user-info">
        <text class="user-name">{{userInfo.nickname || '未登录'}}</text>
        <text class="user-role">{{userInfo.roleText || '普通用户'}}</text>
      </view>
    </view>
    <view class="user-stats">
      <view class="stat-item">
        <text class="stat-num">{{userInfo.creditScore || 100}}</text>
        <text class="stat-label">信用积分</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">{{volunteerData.feedingCount || 0}}</text>
        <text class="stat-label">投喂次数</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">{{volunteerData.serviceHours || 0}}</text>
        <text class="stat-label">服务时长</text>
      </view>
    </view>
  </view>

  <!-- 功能列表 -->
  <view class="menu-list">
    <view class="menu-item card" bindtap="goToPage" data-url="/pages/adoption/list">
      <text class="menu-icon"></text>
      <text class="menu-text">我的领养</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item card" bindtap="goToPage" data-url="/pages/feeding/list">
      <text class="menu-icon"></text>
      <text class="menu-text">投喂记录</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item card" bindtap="onVolunteerApply">
      <text class="menu-icon"></text>
      <text class="menu-text">申请志愿者</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item card" bindtap="onSettings">
      <text class="menu-icon"></text>
      <text class="menu-text">设置</text>
      <text class="menu-arrow">></text>
    </view>
  </view>

  <!-- 退出登录 -->
  <button class="btn-outline" style="margin-top: 40rpx;" bindtap="onLogout" wx:if="{{userInfo}}">
    退出登录
  </button>
</view>
