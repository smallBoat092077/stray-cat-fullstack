.container { padding: 24rpx; }

/* 用户卡 —— 墨绿茶票 + 描金双框 */
.user-card {
  padding: 40rpx 32rpx;
  background: linear-gradient(150deg, var(--brand) 0%, var(--brand-deep) 100%);
  border: 2rpx solid var(--gold);
  outline: 1rpx solid rgba(195, 161, 95, 0.30);
  outline-offset: -10rpx;
  border-radius: 16rpx;
  box-shadow: 0 10rpx 30rpx rgba(12, 51, 41, 0.28);
}

.user-header {
  display: flex;
  align-items: center;
  margin-bottom: 36rpx;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  border: 2rpx solid var(--gold);
  box-shadow: 0 0 0 6rpx rgba(195, 161, 95, 0.16);
}

.user-name {
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  font-size: 38rpx;
  font-weight: 600;
  color: #F7F2E6;
  letter-spacing: 3rpx;
  display: block;
}

.user-role {
  font-size: 24rpx;
  color: var(--gold);
  letter-spacing: 2rpx;
  margin-top: 10rpx;
  display: block;
}

.user-stats {
  display: flex;
  justify-content: space-around;
  padding-top: 28rpx;
  border-top: 1rpx solid rgba(195, 161, 95, 0.32);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  font-size: 44rpx;
  font-weight: 600;
  color: var(--gold);
  letter-spacing: 2rpx;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(247, 242, 230, 0.72);
  letter-spacing: 2rpx;
  margin-top: 10rpx;
}

.menu-list { margin-top: 32rpx; }

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 28rpx;
}

.menu-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: var(--ink);
  letter-spacing: 2rpx;
}

.menu-text-wrap {
  flex: 1;
  display: flex;
  align-items: center;
}

.menu-badge {
  margin-left: 14rpx;
  min-width: 34rpx;
  padding: 0 10rpx;
  border-radius: 34rpx;
  background: var(--brick);
  color: #FFFDF7;
  font-size: 22rpx;
  line-height: 34rpx;
  text-align: center;
}

.menu-arrow {
  font-size: 28rpx;
  color: var(--gold);
}

.coin-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 28rpx 24rpx;
}

.coin-left {
  display: flex;
  flex-direction: column;
}

.coin-num {
  font-size: 48rpx;
  font-weight: 600;
  color: var(--brand);
}

.coin-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ink-mute);
}

.coin-actions {
  display: flex;
  align-items: center;
}

.coin-signin {
  padding: 14rpx 26rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: var(--paper);
  background: linear-gradient(135deg, var(--brand-soft), var(--brand));
}

.coin-signin.done {
  color: var(--ink-mute);
  background: var(--cream);
}

.coin-detail {
  margin-left: 24rpx;
  padding: 14rpx 8rpx;
  font-size: 26rpx;
  color: var(--gold-deep);
}

.danger-link {
  margin-top: 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--brick);
}

.user-edit {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--gold);
  letter-spacing: 2rpx;
}

.edit-mask {
  position: fixed;
  inset: 0;
  background: rgba(12, 51, 41, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.edit-panel {
  width: 100%;
  background: var(--paper);
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
}

.edit-title {
  display: block;
  text-align: center;
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--brand-deep);
  letter-spacing: 3rpx;
  margin-bottom: 24rpx;
}

.edit-row {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--gold-mist);
}

.edit-label {
  width: 120rpx;
  font-size: 28rpx;
  color: var(--ink-soft);
}

.avatar-btn {
  margin: 0 0 0 auto;
  padding: 0;
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  overflow: hidden;
  background: none;
  line-height: 0;
  border: none;
}

.avatar-btn::after {
  border: none;
}

.avatar-preview {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
}

.nickname-input {
  flex: 1;
  margin-left: 20rpx;
  font-size: 28rpx;
  color: var(--ink);
}

.edit-actions {
  display: flex;
  margin-top: 40rpx;
}

.edit-cancel,
.edit-save {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 12rpx;
  font-size: 30rpx;
  letter-spacing: 2rpx;
}

.edit-cancel {
  color: var(--ink-mute);
  background: var(--cream);
  margin-right: 24rpx;
}

.edit-save {
  color: var(--paper);
  background: linear-gradient(135deg, var(--brand-soft), var(--brand));
}

.edit-save.disabled {
  opacity: 0.6;
}
