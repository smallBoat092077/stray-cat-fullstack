.list-page {
  padding-bottom: 120rpx;
}

.list-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: var(--paper);
  border: 1rpx solid var(--gold-mist);
  border-radius: 999rpx;
  padding: 0 20rpx;
}

.search-input {
  flex: 1;
  height: 64rpx;
  font-size: 26rpx;
  color: var(--ink);
}

.search-btn {
  font-size: 24rpx;
  color: var(--gold-deep);
  padding-left: 16rpx;
  flex-shrink: 0;
}

.publish-btn {
  flex-shrink: 0;
  padding: 16rpx 22rpx;
  font-size: 24rpx;
  color: var(--brand);
  background: var(--mist);
  border: 1rpx solid var(--gold-mist);
  border-radius: 999rpx;
}

.result-line {
  font-size: 24rpx;
  color: var(--ink-soft);
  margin-bottom: 16rpx;
}

.post-card {
  display: flex;
  align-items: stretch;
  padding: 20rpx;
}

.post-cover {
  width: 176rpx;
  height: 176rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: var(--cream);
}

.post-cover-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  color: var(--brand-soft);
  border: 1rpx solid var(--gold-mist);
  background: linear-gradient(135deg, var(--mist), var(--sand));
}

.post-body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.post-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.post-name {
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--brand);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.post-meta {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--ink-soft);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.post-foot {
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.post-reason {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: var(--ink-mute);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.post-apply {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--gold-deep);
}

.error-tip {
  text-align: center;
  padding: 60rpx 0;
  font-size: 26rpx;
  color: var(--brick);
}

.empty-link {
  display: inline-block;
  margin-top: 24rpx;
  padding: 14rpx 32rpx;
  font-size: 26rpx;
  color: var(--brand);
  border: 1rpx solid rgba(195, 161, 95, 0.45);
  border-radius: 999rpx;
}

.bottom-tip {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  padding: 18rpx 28rpx;
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  font-size: 22rpx;
  line-height: 1.5;
  color: #7B6637;
  text-align: center;
  background: #FBF4E4;
  border-top: 1rpx solid var(--gold-mist);
}
