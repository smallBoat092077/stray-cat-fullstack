.post-card {
  padding: 20rpx;
}

.post-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.post-cover {
  width: 104rpx;
  height: 104rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.post-cover-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: var(--brand-soft);
  background: linear-gradient(135deg, var(--mist), var(--sand));
  border: 1rpx solid var(--gold-mist);
}

.post-info {
  flex: 1;
  min-width: 0;
}

.post-title {
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--brand);
}

.post-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-mute);
}

.post-arrow {
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--gold-deep);
}

.apply-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.apply-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--brand);
}

.muted {
  font-size: 22rpx;
  color: var(--ink-mute);
}

.apply-empty {
  text-align: center;
  padding: 30rpx 0;
  font-size: 24rpx;
  color: var(--ink-mute);
}

.apply-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx dashed var(--gold-mist);
}

.apply-avatar {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--brand);
  background: var(--mist);
  border: 1rpx solid var(--gold-mist);
}

.apply-info {
  flex: 1;
  min-width: 0;
}

.apply-name {
  font-size: 24rpx;
  color: var(--ink);
}

.apply-phone {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--brand);
}

.apply-note {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-mute);
  line-height: 1.5;
}

.apply-actions {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  flex-shrink: 0;
}

.post-actions {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
}

.mini-btn {
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  border-radius: 999rpx;
  text-align: center;
  border: 1rpx solid transparent;
}

.mini-btn.ghost {
  color: var(--brand);
  background: var(--mist);
  border-color: var(--gold-mist);
}

.mini-btn.line {
  color: var(--brand);
  background: var(--paper);
  border-color: var(--gold);
}

.mini-btn.primary {
  color: #FFFDF7;
  background: var(--brand);
}

.error-tip {
  text-align: center;
  padding: 40rpx 0;
  font-size: 26rpx;
  color: var(--brick);
}

.empty-link {
  display: inline-block;
  margin-top: 24rpx;
  padding: 14rpx 32rpx;
  font-size: 26rpx;
  color: var(--brand);
  border: 1rpx solid rgba(195, 161, 95, 0.45);
  border-radius: 999rpx;
}
