<brand-nav back="{{true}}" />
<view class="container publish-page">

  <view class="form-item">
    <label class="form-label">猫咪照片（1–6 张，第一张为封面）</label>
    <view class="photos">
      <view class="photo-item" wx:for="{{photos}}" wx:key="index">
        <image src="{{item}}" mode="aspectFill" data-src="{{item}}" bindtap="previewImage" />
        <view class="photo-cover" wx:if="{{index === 0}}">封面</view>
        <view class="photo-del" data-index="{{index}}" catchtap="removeImage">×</view>
      </view>
      <view class="photo-add" wx:if="{{photos.length < 6}}" bindtap="chooseImage">＋</view>
    </view>
  </view>

  <view class="form-item">
    <label class="form-label">猫咪名字</label>
    <input class="form-input" placeholder="例如：小满" data-field="catName" value="{{catName}}" bindinput="onInput" />
  </view>

  <view class="form-item">
    <label class="form-label">品种</label>
    <input class="form-input" placeholder="例如：橘猫 / 英短 / 中华田园猫" data-field="breed" value="{{breed}}" bindinput="onInput" />
  </view>

  <view class="form-item">
    <label class="form-label">年龄（月龄）</label>
    <input class="form-input" type="number" placeholder="例如：24（表示 2 岁）" data-field="ageMonths" value="{{ageMonths}}" bindinput="onInput" />
  </view>

  <view class="form-item">
    <label class="form-label">性别</label>
    <view class="choice-row">
      <view wx:for="{{genders}}" wx:key="value"
            class="choice-item {{gender === item.value ? 'active' : ''}}"
            data-value="{{item.value}}" bindtap="onGender">{{item.label}}</view>
    </view>
  </view>

  <view class="form-item">
    <label class="form-label">是否绝育</label>
    <view class="choice-row">
      <view wx:for="{{yesNo}}" wx:key="value"
            class="choice-item {{neutered === item.value ? 'active' : ''}}"
            data-value="{{item.value}}" bindtap="onNeutered">{{item.label}}</view>
    </view>
  </view>

  <view class="form-item">
    <label class="form-label">疫苗是否齐全</label>
    <view class="choice-row">
      <view wx:for="{{yesNo}}" wx:key="value"
            class="choice-item {{vaccinated === item.value ? 'active' : ''}}"
            data-value="{{item.value}}" bindtap="onVaccinated">{{item.label}}</view>
    </view>
  </view>

  <view class="form-item">
    <label class="form-label">健康状况（选填）</label>
    <input class="form-input" placeholder="例如：健康良好，无慢性病" data-field="healthNote" value="{{healthNote}}" bindinput="onInput" />
  </view>

  <view class="form-item">
    <label class="form-label">性格（选填）</label>
    <input class="form-input" placeholder="例如：亲人温顺" data-field="personality" value="{{personality}}" bindinput="onInput" />
  </view>

  <view class="form-item">
    <label class="form-label">所在区域（到区即可，不用详细门牌）</label>
    <region-picker bind:change="onRegionChange" />
    <view class="region-chosen" wx:if="{{regionLabel}}">已选：{{regionLabel}}</view>
  </view>

  <view class="form-item">
    <label class="form-label">模糊地点（选填，如「洪山区」）</label>
    <input class="form-input" placeholder="只到区或街道，不必写门牌" data-field="addressHint" value="{{addressHint}}" bindinput="onInput" />
  </view>

  <view class="form-item">
    <label class="form-label">转让原因</label>
    <textarea class="form-textarea" placeholder="为什么需要为它找新家？" data-field="reason" value="{{reason}}" bindinput="onInput" />
  </view>

  <view class="form-item">
    <label class="form-label">对新主人的期望</label>
    <textarea class="form-textarea" placeholder="例如：稳定住所、家人同意、愿意定期反馈近况" data-field="requirement" value="{{requirement}}" bindinput="onInput" />
  </view>

  <view class="form-divider"></view>

  <view class="form-item">
    <label class="form-label">联系人称呼</label>
    <input class="form-input" placeholder="例如：林女士" data-field="contactName" value="{{contactName}}" bindinput="onInput" />
  </view>

  <view class="form-item">
    <label class="form-label">手机号（仅用于接收申请通知，不会公开展示）</label>
    <input class="form-input" type="number" maxlength="11" placeholder="11 位手机号" data-field="contactPhone" value="{{contactPhone}}" bindinput="onInput" />
  </view>

  <view class="promise" bindtap="onPromise">
    <view class="promise-box {{promised ? 'checked' : ''}}">{{promised ? '✓' : ''}}</view>
    <text class="promise-text">我确认该猫为本人饲养，并非买卖、繁育或商业用途；同意平台审核后公开展示资料。</text>
  </view>

  <button class="btn-primary submit-btn" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onSubmit">提交审核</button>

  <view class="tip-box">提交后状态为「待审」，只有自己可见。管理员审核通过后才会进入列表；本功能不涉及任何费用与交易担保。</view>
</view>
