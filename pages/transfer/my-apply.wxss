.apply-card {
  padding: 24rpx;
}

.apply-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.apply-cat {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-width: 0;
}

.cat-icon {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  color: var(--brand);
  background: var(--mist);
  border: 1rpx solid var(--gold-mist);
}

.cat-name {
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--brand);
}

.cat-time {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-mute);
}

.apply-note {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: var(--ink-soft);
  line-height: 1.7;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.apply-hint {
  margin-top: 16rpx;
  text-align: right;
  font-size: 22rpx;
  color: var(--gold-deep);
}

.error-tip {
  text-align: center;
  padding: 120rpx 0;
  font-size: 26rpx;
  color: var(--brick);
}

.empty-link {
  display: inline-block;
  margin-top: 24rpx;
  padding: 14rpx 32rpx;
  font-size: 26rpx;
  color: var(--brand);
  border: 1rpx solid rgba(195, 161, 95, 0.45);
  border-radius: 999rpx;
}
