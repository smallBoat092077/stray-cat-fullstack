.detail-page {
  padding: 24rpx 24rpx 160rpx;
  box-sizing: border-box;
}

.closed-bar {
  padding: 18rpx 22rpx;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: #8A857A;
  background: #ECE8DA;
  border: 1rpx solid var(--gold-mist);
  border-radius: 12rpx;
  text-align: center;
}

.gallery {
  position: relative;
  width: 100%;
  height: 380rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, var(--mist), var(--sand));
  border: 1rpx solid var(--gold-mist);
}

.gallery-swiper {
  width: 100%;
  height: 100%;
}

.gallery-swiper image {
  width: 100%;
  height: 100%;
}

.gallery-count {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  color: #FFF;
  background: rgba(20, 73, 60, 0.7);
  border-radius: 999rpx;
}

.gallery-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 120rpx;
  color: var(--brand-soft);
}

.between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.detail-title {
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--brand);
  margin-bottom: 8rpx;
}

.muted {
  font-size: 24rpx;
  color: var(--ink-mute);
}

.free-label {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--brand-soft);
}

.kv {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.kv-item {
  padding: 18rpx 20rpx;
  font-size: 22rpx;
  color: var(--ink-mute);
  background: #F8F5EC;
  border-radius: 12rpx;
}

.kv-val {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--brand);
  font-weight: 500;
}

.text-block {
  font-size: 26rpx;
  line-height: 1.8;
  color: var(--ink-soft);
}

.danger-line {
  margin-top: 24rpx;
  padding: 20rpx 22rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #99543F;
  background: #FCF2ED;
  border: 1rpx solid #EED6C8;
  border-radius: 12rpx;
}

.bottom-space {
  height: 20rpx;
}

.error-tip {
  text-align: center;
  padding: 120rpx 0;
  font-size: 26rpx;
  color: var(--brick);
}

.fixed-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 95;
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: var(--paper);
  border-top: 1rpx solid var(--gold-mist);
}

.report-btn {
  flex: 0 0 150rpx;
  padding: 18rpx 0;
  margin: 0;
  font-size: 26rpx;
}

.apply-btn {
  flex: 1;
  padding: 18rpx 0;
  margin: 0;
  font-size: 28rpx;
}
