<brand-nav back="{{true}}" />
<view class="container my-apply-page">

  <view class="loading" wx:if="{{loading}}">加载中...</view>
  <view class="error-tip" wx:if="{{error}}" bindtap="onRetry">加载失败，点击重试</view>

  <block wx:if="{{!loading && !error}}">
    <view class="apply-card card" wx:for="{{list}}" wx:key="id"
          data-post="{{item.postId}}" bindtap="goDetail">
      <view class="apply-top">
        <view class="apply-cat">
          <view class="cat-icon">⌂</view>
          <view>
            <view class="cat-name">{{item.postCatName || '待领养的猫'}}</view>
            <view class="cat-time">{{item.createdText}}</view>
          </view>
        </view>
        <text class="tag tag-{{item.statusClass}}">{{item.statusText}}</text>
      </view>
      <view class="apply-note" wx:if="{{item.applyNote}}">{{item.applyNote}}</view>
      <view class="apply-hint">点击查看猫咪详情 ›</view>
    </view>

    <view class="empty" wx:if="{{list.length === 0}}">
      <text class="empty-icon">⌂</text>
      <text>你还没有提交过接猫申请</text>
      <view class="empty-link" bindtap="goList">去看看待领养的猫 ›</view>
    </view>
  </block>
</view>
