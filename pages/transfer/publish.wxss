.publish-page {
  padding-bottom: 60rpx;
}

.photos {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.photo-item,
.photo-add {
  width: 150rpx;
  height: 150rpx;
  border-radius: 12rpx;
  position: relative;
  box-sizing: border-box;
}

.photo-item image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  border: 1rpx solid var(--gold-mist);
}

.photo-cover {
  position: absolute;
  left: 0;
  bottom: 0;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  color: #FFFDF7;
  background: rgba(20, 73, 60, 0.8);
  border-radius: 0 0 0 12rpx;
}

.photo-del {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  font-size: 30rpx;
  color: #FFF;
  background: var(--brick);
  border-radius: 50%;
}

.photo-add {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  color: var(--gold-deep);
  border: 2rpx dashed var(--gold);
  background: rgba(255, 253, 247, 0.6);
}

.choice-row {
  display: flex;
  gap: 16rpx;
}

.choice-item {
  padding: 12rpx 40rpx;
  font-size: 26rpx;
  color: var(--ink-soft);
  background: var(--pill-mint);
  border-radius: 999rpx;
  border: 1rpx solid transparent;
}

.choice-item.active {
  color: #FFFDF7;
  background: var(--brand);
  border-color: var(--brand);
}

.region-chosen {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--gold-deep);
}

.form-divider {
  height: 1rpx;
  background: var(--gold-mist);
  margin: 32rpx 0;
}

.promise {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin: 12rpx 0 28rpx;
}

.promise-box {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid var(--gold);
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #FFF;
}

.promise-box.checked {
  background: var(--brand);
  border-color: var(--brand);
}

.promise-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--ink-soft);
  line-height: 1.6;
}

.submit-btn {
  width: 100%;
}

.tip-box {
  margin-top: 24rpx;
  padding: 18rpx 20rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #7B6637;
  background: #FBF4E4;
  border: 1rpx dashed var(--gold-mist);
  border-radius: 12rpx;
}
