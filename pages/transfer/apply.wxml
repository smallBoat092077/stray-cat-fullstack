<brand-nav back="{{true}}" />
<view class="container apply-page">

  <view class="loading" wx:if="{{loading}}">加载中...</view>
  <view class="error-tip" wx:if="{{error}}" bindtap="onRetry">加载失败，点击重试</view>

  <block wx:if="{{!loading && cat}}">
    <view class="cat-summary card">
      <image class="summary-cover" src="{{cat.cover}}" mode="aspectFill" wx:if="{{cat.cover}}" />
      <view class="summary-cover summary-empty" wx:else>⌂</view>
      <view class="summary-body">
        <view class="summary-title">{{cat.catName}} <text class="tag tag-success" wx:if="{{cat.breed}}">{{cat.breed}}</text></view>
        <view class="summary-meta">{{cat.ageText}} · 等待新家</view>
      </view>
    </view>

    <view class="phone-notice">手机号仅发送给猫主人，用于线下联系，不会在平台公开。</view>

    <view class="form-item">
      <label class="form-label">你的称呼</label>
      <input class="form-input" placeholder="例如：周先生" data-field="contactName" value="{{contactName}}" bindinput="onInput" />
    </view>

    <view class="form-item">
      <label class="form-label">手机号（仅发送给猫主人）</label>
      <input class="form-input" type="number" maxlength="11" placeholder="11 位手机号" data-field="contactPhone" value="{{contactPhone}}" bindinput="onInput" />
    </view>

    <view class="form-item">
      <label class="form-label">为什么想接它 / 你的养猫经验</label>
      <textarea class="form-textarea" placeholder="说说你的住处、养猫经历和照顾它的打算" data-field="applyNote" value="{{applyNote}}" bindinput="onInput" />
    </view>

    <view class="form-item">
      <label class="form-label">家人是否同意养猫</label>
      <view class="choice-row">
        <view wx:for="{{yesNo}}" wx:key="value"
              class="choice-item {{familyAgree === item.value ? 'active' : ''}}"
              data-value="{{item.value}}" bindtap="onFamilyAgree">{{item.label}}</view>
      </view>
    </view>

    <view class="form-item">
      <label class="form-label">家里是否已有其他宠物</label>
      <view class="choice-row">
        <view wx:for="{{yesNo}}" wx:key="value"
              class="choice-item {{hasOtherPets === item.value ? 'active' : ''}}"
              data-value="{{item.value}}" bindtap="onHasOtherPets">{{item.label}}</view>
      </view>
    </view>

    <view class="promise" bindtap="onPromise">
      <view class="promise-box {{promised ? 'checked' : ''}}">{{promised ? '✓' : ''}}</view>
      <text class="promise-text">我承诺真诚领养、不转卖不弃养，并同意猫主人适时了解它的近况。</text>
    </view>

    <button class="btn-primary submit-btn" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onSubmit">提交申请</button>

    <view class="tip-box">防重复：同一用户对同一只猫只能提交一次。提交后系统给猫主人发一条站内消息，不做聊天会话。</view>
  </block>
</view>
