.container { padding: 24rpx; }

.adoption-item { padding: 28rpx; }

.adoption-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.cat-name {
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: var(--brand);
}

.adoption-info {
  font-size: 24rpx;
  color: var(--ink-soft);
  margin-bottom: 10rpx;
}

.adoption-actions {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--gold-mist);
}

.btn-small {
  padding: 12rpx 34rpx;
  font-size: 26rpx;
  border-radius: 6rpx;
  letter-spacing: 2rpx;
}

/* 共同领养：邀请区与名单 */
.co-section {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.co-title {
  display: block;
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--brand-deep);
  letter-spacing: 3rpx;
  margin-bottom: 20rpx;
}

.co-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-top: 1rpx solid var(--gold-mist);
}

.co-item-main {
  display: flex;
  flex-direction: column;
  flex: 1;
  margin-right: 20rpx;
}

.co-cat {
  font-size: 28rpx;
  color: var(--ink);
  letter-spacing: 1rpx;
}

.co-inviter,
.co-done-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-mute);
}

.co-actions {
  display: flex;
  align-items: center;
}

.co-btn {
  padding: 12rpx 28rpx;
  border-radius: 6rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.co-btn-ghost {
  color: var(--ink-mute);
  background: var(--cream);
  margin-right: 16rpx;
}

.co-btn-solid {
  color: var(--paper);
  background: linear-gradient(135deg, var(--brand-soft), var(--brand));
}

.co-done {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 18rpx 0;
  border-top: 1rpx solid var(--gold-mist);
}

.co-count {
  color: var(--gold-deep);
}

.invite-btn {
  margin-top: 0;
}
