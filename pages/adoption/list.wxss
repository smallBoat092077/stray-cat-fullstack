.container { padding: 20rpx; }

.filter-bar {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 20rpx;
}

.filter-item {
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  margin-right: 12rpx;
  background: #f5f5f5;
}

.filter-item.active {
  background: #FF6B6B;
  color: #fff;
}

.adoption-item { padding: 24rpx; }

.adoption-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.cat-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.adoption-info {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.adoption-actions {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.btn-small {
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  border-radius: 30rpx;
}
