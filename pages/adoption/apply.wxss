.container { padding: 20rpx; }

.card { padding: 24rpx; }

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 24rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.form-value {
  font-size: 28rpx;
  color: #666;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-input {
  font-size: 28rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-textarea {
  font-size: 28rpx;
  width: 100%;
  height: 160rpx;
  padding: 16rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  box-sizing: border-box;
}
