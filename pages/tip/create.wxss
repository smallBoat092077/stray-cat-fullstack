.container {
  padding: 24rpx 24rpx 220rpx;
}

.cat-brief {
  display: flex;
  align-items: center;
  padding: 24rpx;
}

.cat-cover {
  width: 128rpx;
  height: 128rpx;
  border-radius: 8rpx;
  background: var(--cream);
}

.cat-meta {
  display: flex;
  flex-direction: column;
  margin-left: 24rpx;
}

.cat-name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
  font-family: "Songti SC", serif;
  letter-spacing: 2rpx;
}

.cat-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--ink-mute);
}

.wallet {
  margin-top: 24rpx;
  padding: 28rpx 24rpx;
  display: flex;
  align-items: center;
}

.wallet-row {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.wallet-label {
  font-size: 24rpx;
  color: var(--ink-mute);
}

.wallet-value {
  margin-top: 8rpx;
  font-size: 44rpx;
  font-weight: 600;
  color: var(--brand);
}

.wallet-value.subtle {
  font-size: 36rpx;
  color: var(--gold-deep);
}

.signin {
  padding: 14rpx 26rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: var(--paper);
  background: linear-gradient(135deg, var(--brand-soft), var(--brand));
}

.signin.done {
  color: var(--ink-mute);
  background: var(--cream);
}

.amount-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.amount-item {
  width: calc((100% - 48rpx) / 3);
  margin: 0 24rpx 24rpx 0;
  padding: 28rpx 0;
  text-align: center;
  background: var(--paper);
  border: 2rpx solid var(--gold-mist);
  border-radius: 8rpx;
}

.amount-item:nth-child(3n) {
  margin-right: 0;
}

.amount-item.active {
  border-color: var(--brand);
  background: rgba(20, 73, 60, 0.06);
}

.amount-num {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--ink);
}

.amount-item.active .amount-num {
  color: var(--brand);
}

.amount-num.custom {
  font-size: 30rpx;
  font-weight: 400;
}

.amount-unit {
  margin-left: 6rpx;
  font-size: 24rpx;
  color: var(--ink-mute);
}

.custom-input,
.message-input {
  margin-top: 8rpx;
  padding: 26rpx 24rpx;
  font-size: 30rpx;
  color: var(--ink);
}

.notice {
  margin-top: 20rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--ink-soft);
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--cream);
  border-top: 2rpx solid var(--gold-mist);
}

.footer-link {
  margin-top: 16rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--gold-deep);
}
