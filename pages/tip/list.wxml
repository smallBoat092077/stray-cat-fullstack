<view class="container">
  <view class="summary card">
    <view class="summary-item">
      <text class="summary-num">{{balance}}</text>
      <text class="summary-label">当前猫粮</text>
    </view>
    <view class="summary-line"></view>
    <view class="summary-item">
      <text class="summary-num gold">{{tipped}}</text>
      <text class="summary-label">累计送出</text>
    </view>
  </view>

  <view class="tabs">
    <view class="tab {{tab === 'tip' ? 'active' : ''}}" data-tab="tip" bindtap="onSwitchTab">我送出的猫粮</view>
    <view class="tab {{tab === 'flow' ? 'active' : ''}}" data-tab="flow" bindtap="onSwitchTab">猫粮明细</view>
  </view>

  <block wx:if="{{tab === 'tip'}}">
    <view class="empty card" wx:if="{{!tips.length && !loading}}" bindtap="onGoCreate">
      还没有送出过猫粮，去猫咪列表看看吧
    </view>
    <view class="item card" wx:for="{{tips}}" wx:key="id">
      <view class="item-head">
        <text class="item-title">{{item.catName}}</text>
        <text class="item-amount">-{{item.coinAmount}}</text>
      </view>
      <text class="item-msg" wx:if="{{item.message}}">{{item.message}}</text>
      <text class="item-time">{{item.timeText}}</text>
    </view>
  </block>

  <block wx:else>
    <view class="empty card" wx:if="{{!flows.length && !loading}}">
      还没有猫粮记录，签到、上报猫咪、完成投喂打卡都能获得
    </view>
    <view class="item card" wx:for="{{flows}}" wx:key="id">
      <view class="item-head">
        <text class="item-title">{{item.bizText}}</text>
        <text class="item-amount {{item.gain ? 'gain' : ''}}">{{item.gain ? '+' : ''}}{{item.amount}}</text>
      </view>
      <text class="item-msg" wx:if="{{item.remark}}">{{item.remark}}</text>
      <text class="item-time">{{item.timeText}} · 余额 {{item.balanceAfter}}</text>
    </view>
  </block>

  <view class="loadmore" wx:if="{{loading}}">加载中...</view>
  <view class="loadmore" wx:elif="{{tab === 'tip' && !tipHasMore && tips.length}}">没有更多了</view>
  <view class="loadmore" wx:elif="{{tab === 'flow' && !flowHasMore && flows.length}}">没有更多了</view>
</view>
