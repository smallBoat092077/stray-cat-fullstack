<view class="container" wx:if="{{ready}}">
  <view class="filter-bar">
    <view class="filter-item {{tab === 'adoption' ? 'active' : ''}}" bindtap="onTab" data-tab="adoption">领养申请</view>
    <view class="filter-item {{tab === 'record' ? 'active' : ''}}" bindtap="onTab" data-tab="record">投喂打卡</view>
  </view>

  <view class="scope-row">
    <text class="scope {{pendingOnly ? 'active' : ''}}" bindtap="onScope" data-pending="1">待审核</text>
    <text class="scope {{!pendingOnly ? 'active' : ''}}" bindtap="onScope" data-pending="0">全部</text>
  </view>

  <block wx:if="{{tab === 'adoption'}}">
    <view class="card review-item" wx:for="{{adoptionList}}" wx:key="id">
      <view class="item-head">
        <text class="item-title">{{item.catName}} · 申请人 {{item.applicantName}}</text>
        <text class="tag tag-{{item.statusClass}}">{{item.statusText}}</text>
      </view>
      <view class="row">
        <text class="label">住房</text>
        <text class="value">{{item.housingText}}{{item.housingArea ? ' · ' + item.housingArea + '㎡' : ''}}</text>
      </view>
      <view class="row">
        <text class="label">其他宠物</text>
        <text class="value">{{item.hasOtherPets ? '有' : '无'}}</text>
      </view>
      <view class="row">
        <text class="label">家人态度</text>
        <text class="value">{{item.familyAgree ? '同意' : '未确认'}}</text>
      </view>
      <view class="row">
        <text class="label">养猫经验</text>
        <text class="value">{{item.catExperience || '未填写'}}</text>
      </view>
      <view class="row">
        <text class="label">领养原因</text>
        <text class="value">{{item.adoptionReason || '未填写'}}</text>
      </view>
      <view class="row">
        <text class="label">作息</text>
        <text class="value">{{item.workSchedule || '未填写'}}</text>
      </view>
      <view class="row">
        <text class="label">联系方式</text>
        <text class="value">
          <text class="phone" wx:if="{{item.contactPhone}}" data-phone="{{item.contactPhone}}" bindtap="onCall">{{item.contactPhone}}</text>
          <text wx:if="{{item.contactWechat}}"> 微信 {{item.contactWechat}}</text>
          <text wx:if="{{!item.contactPhone && !item.contactWechat}}">未填写</text>
        </text>
      </view>
      <view class="row" wx:if="{{item.reviewComment}}">
        <text class="label">审核意见</text>
        <text class="value">{{item.reviewComment}}</text>
      </view>
      <view class="actions" wx:if="{{item.status === 0 || item.status === 1}}">
        <view class="act-btn ghost" data-id="{{item.id}}" bindtap="onReject">拒绝</view>
        <view class="act-btn solid" data-id="{{item.id}}" bindtap="onApprove">通过</view>
      </view>
    </view>
    <view class="empty" wx:if="{{!loading && adoptionList.length === 0}}">
      <text>{{pendingOnly ? '没有待审核的领养申请' : '还没有领养申请'}}</text>
    </view>
  </block>

  <block wx:else>
    <view class="card review-item" wx:for="{{recordList}}" wx:key="id" wx:for-index="ri">
      <view class="item-head">
        <text class="item-title">{{item.catName}} · {{item.volunteerName}}</text>
        <text class="tag tag-{{item.statusClass}}">{{item.statusText}}</text>
      </view>
      <view class="row">
        <text class="label">打卡时间</text>
        <text class="value">{{item.timeText}}</text>
      </view>
      <view class="row">
        <text class="label">距投喂点</text>
        <text class="value">{{item.distance}} 米</text>
      </view>
      <view class="row" wx:if="{{item.foodUsed}}">
        <text class="label">投喂食物</text>
        <text class="value">{{item.foodUsed}}</text>
      </view>
      <view class="row" wx:if="{{item.reviewComment}}">
        <text class="label">审核意见</text>
        <text class="value">{{item.reviewComment}}</text>
      </view>
      <view class="imgs" wx:if="{{item.images.length > 0}}">
        <image class="img" wx:for="{{item.images}}" wx:for-item="img" wx:for-index="ii" wx:key="*this"
               src="{{img}}" mode="aspectFill"
               data-index="{{ri}}" data-img="{{img}}" bindtap="previewRecordImage" />
      </view>
      <view class="actions" wx:if="{{item.status === 0}}">
        <view class="act-btn ghost" data-id="{{item.id}}" bindtap="onReject">拒绝</view>
        <view class="act-btn solid" data-id="{{item.id}}" bindtap="onApprove">通过</view>
      </view>
    </view>
    <view class="empty" wx:if="{{!loading && recordList.length === 0}}">
      <text>{{pendingOnly ? '没有待审核的打卡记录' : '还没有投喂打卡记录'}}</text>
    </view>
  </block>
</view>
