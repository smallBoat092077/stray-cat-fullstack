<view class="container">
  <!-- 搜索框 -->
  <view class="search-bar">
    <view class="search-input-wrap">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        placeholder="搜索名称 / 品种 / 毛色"
        placeholder-class="search-placeholder"
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
        bindconfirm="onSearchConfirm"
        confirm-type="search"
      />
      <text class="search-clear" wx:if="{{searchKeyword}}" bindtap="onSearchClear">×</text>
    </view>
  </view>

  <!-- 海报轮播 -->
  <swiper
    class="poster-swiper"
    indicator-dots
    autoplay
    circular
    interval="4000"
    indicator-active-color="#C3A15F"
    indicator-color="rgba(255,253,247,0.5)"
    bindchange="onSwiperChange"
    wx:if="{{posters.length > 0}}"
  >
    <swiper-item wx:for="{{posters}}" wx:key="id">
      <image class="poster-img" src="{{item.imageUrl}}" mode="aspectFill" />
    </swiper-item>
  </swiper>

  <!-- 筛选栏 -->
  <view class="filter-bar">
    <view class="filter-item {{currentStatus === '' ? 'active' : ''}}" bindtap="onStatusFilter" data-status="">全部</view>
    <view class="filter-item {{currentStatus === 0 ? 'active' : ''}}" bindtap="onStatusFilter" data-status="0">流浪中</view>
    <view class="filter-item {{currentStatus === 1 ? 'active' : ''}}" bindtap="onStatusFilter" data-status="1">投喂中</view>
    <view class="filter-item {{currentStatus === 2 ? 'active' : ''}}" bindtap="onStatusFilter" data-status="2">待领养</view>
    <view class="filter-item {{currentStatus === 3 ? 'active' : ''}}" bindtap="onStatusFilter" data-status="3">已领养</view>
  </view>

  <!-- 猫咪列表 -->
  <view class="cat-list">
    <view
      class="cat-item card {{focusedCat && item.id === focusedCat.id ? 'cat-item-focused' : ''}}"
      wx:for="{{displayList}}"
      wx:key="id"
      catchtap="goToDetail"
      data-id="{{item.id}}"
    >
      <image class="cat-img" src="{{item.coverImage || '/images/default-cat.png'}}" mode="aspectFill" />
      <view class="cat-content">
        <view class="cat-header">
          <text class="cat-name">{{item.name}}</text>
          <text class="tag tag-{{item.lifeStatusClass}}">{{item.lifeStatusText}}</text>
        </view>
        <view class="focus-hint" wx:if="{{focusedCat && item.id === focusedCat.id}}">刚在地图上选中</view>
        <view class="cat-detail">
          <text>{{item.genderText}} · {{item.ageEstimate}} · {{item.color}}</text>
        </view>
        <view class="cat-detail">
          <text>📍 {{item.locationDesc}}</text>
        </view>
        <view class="cat-desc">{{item.description}}</view>
        <view class="cat-footer">
          <text class="cat-views">👁 {{item.viewCount}}</text>
          <text class="cat-likes">❤ {{item.likeCount}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{!loading && displayList.length === 0}}">
    <text class="empty-icon">🐱</text>
    <text>{{searchKeyword ? '没有匹配的猫咪' : '暂无猫咪数据'}}</text>
  </view>

  <!-- 加载中 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
  <view class="loading" wx:if="{{!hasMore && displayList.length > 0}}">
    <text>没有更多了</text>
  </view>
</view>
