.page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.map-wrap {
  position: relative;
  width: 100%;
  height: 46vh;
}

.route-map {
  width: 100%;
  height: 100%;
}

.map-badge {
  position: absolute;
  left: 24rpx;
  top: 24rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 253, 247, 0.92);
  border: 1rpx solid var(--gold-mist);
  font-size: 24rpx;
  color: var(--ink-soft);
}

.body {
  padding: 24rpx;
}

.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.head-name {
  font-size: 36rpx;
  color: var(--brand);
  letter-spacing: 2rpx;
}

.head-loc {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--ink-soft);
}

.metric {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--gold-mist);
}

.metric-main {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.metric-value {
  font-size: 52rpx;
  color: var(--brand);
}

.metric-unit {
  font-size: 24rpx;
  color: var(--ink-mute);
}

.metric-sub {
  font-size: 26rpx;
  color: var(--ink-soft);
}

.note {
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--ink-mute);
}

.error {
  margin: 0 24rpx 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  background: rgba(168, 69, 59, 0.08);
  border: 1rpx solid rgba(168, 69, 59, 0.24);
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--brick);
}

.action-bar {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--paper);
  border-top: 1rpx solid var(--gold-mist);
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  box-shadow: 0 -4rpx 20rpx rgba(20, 73, 60, 0.08);
}

.action-bar button {
  flex: 1;
  font-size: 28rpx;
  padding: 20rpx 0;
}
