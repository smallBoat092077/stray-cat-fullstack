.container { padding: 24rpx; }
.card { padding: 32rpx; }

/* 必填标记 */
.required {
  font-size: 20rpx;
  color: var(--brick);
  background: rgba(168, 69, 59, 0.10);
  border: 1rpx solid rgba(168, 69, 59, 0.26);
  border-radius: 4rpx;
  padding: 2rpx 10rpx;
  margin-left: 10rpx;
  letter-spacing: 1rpx;
}

/* 地图定位 —— 描金虚线选择条 */
.location-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 24rpx;
  background: rgba(195, 161, 95, 0.08);
  border: 2rpx dashed var(--gold);
  border-radius: 10rpx;
}

.location-content { display: flex; align-items: center; flex: 1; overflow: hidden; }
.location-icon { font-size: 36rpx; margin-right: 16rpx; }
.location-text { display: flex; flex-direction: column; flex: 1; overflow: hidden; }
.location-name { font-size: 28rpx; color: var(--ink); letter-spacing: 1rpx; }
.location-coord { font-size: 22rpx; color: var(--ink-mute); margin-top: 6rpx; }
.location-arrow { font-size: 32rpx; color: var(--gold-deep); margin-left: 16rpx; }

/* 图片上传 */
.image-upload-area { margin-top: 12rpx; }
.image-list { display: flex; flex-wrap: wrap; gap: 16rpx; }
.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 10rpx;
  overflow: hidden;
  border: 1rpx solid var(--gold-mist);
}
.image-item image { width: 100%; height: 100%; }
.image-remove {
  position: absolute;
  top: 0;
  right: 0;
  width: 48rpx;
  height: 48rpx;
  background: rgba(12, 51, 41, 0.72);
  color: #F7F2E6;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 10rpx 0 10rpx;
}
.image-add {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed var(--gold);
  border-radius: 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(195, 161, 95, 0.06);
}
.add-icon { font-size: 64rpx; color: var(--gold); line-height: 1; }
.add-text { font-size: 24rpx; color: var(--ink-mute); margin-top: 8rpx; letter-spacing: 1rpx; }
