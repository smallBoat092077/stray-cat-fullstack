.container { padding: 0; }

.cat-swiper {
  width: 100%;
  height: 500rpx;
}

.swiper-img {
  width: 100%;
  height: 100%;
}

.card { margin: 20rpx; padding: 24rpx; }

.info-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.info-name {
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
}

.info-row {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.health-tags {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

.section-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.action-bar {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  background: #fff;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.05);
}

.action-bar button {
  flex: 1;
  font-size: 28rpx;
}
