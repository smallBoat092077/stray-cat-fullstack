.container { padding: 0 24rpx; }

/* 搜索框 */
.search-bar {
  padding: 20rpx 0 16rpx;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background: var(--paper);
  border: 1rpx solid var(--gold-mist);
  border-radius: 999rpx;
  padding: 16rpx 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(20, 73, 60, 0.08);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
}

.search-placeholder {
  color: var(--ink-mute);
}

.search-clear {
  font-size: 36rpx;
  color: var(--ink-mute);
  padding: 0 8rpx;
  line-height: 1;
}

/* 猫咪统计信息条（去轮播改造）：浅底细边圆角条，文案左、去领养链接右 */
.cat-stats {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 18rpx 24rpx;
  margin: 4rpx 0 12rpx;
  background: rgba(195, 161, 95, 0.08);
  border: 1rpx solid rgba(195, 161, 95, 0.25);
  border-radius: 16rpx;
}

.cat-stats-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--ink-soft);
  line-height: 1.5;
}

.cat-stats-link {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--brand);
  font-weight: 600;
  padding: 6rpx 4rpx 6rpx 12rpx;
}

/* 筛选栏：紧凑一行，5 项同屏放下，消除「已领养」截断 */
.filter-bar {
  overflow-x: visible;
  padding: 4rpx 0 16rpx;
}

.filter-bar .filter-item {
  flex: 1;
  padding: 12rpx 0;
  margin-right: 10rpx;
  font-size: 24rpx;
  letter-spacing: 0;
  text-align: center;
}

.filter-bar .filter-item:last-child {
  margin-right: 0;
}

.filter-bar .filter-item.active {
  transform: none;
}
.filter-bar {
  padding: 14rpx 0;
}

.filter-item {
  transition: background .2s;
}

.cat-list { padding-top: 4rpx; }

.cat-item {
  display: flex;
  padding: 24rpx;
}

.cat-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
  border: 1rpx solid var(--gold-mist);
}

.cat-content {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.cat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.cat-name {
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: var(--brand);
}

.cat-detail {
  font-size: 24rpx;
  color: var(--ink-mute);
  margin-top: 8rpx;
}

.cat-desc {
  font-size: 24rpx;
  color: var(--ink-soft);
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.cat-footer {
  display: flex;
  gap: 24rpx;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--gold-mist);
}

.cat-views, .cat-likes {
  font-size: 22rpx;
  color: var(--ink-mute);
}

.cat-item-focused {
  border: 2rpx solid var(--gold);
  box-shadow: 0 6rpx 20rpx var(--gold-mist);
}

.focus-hint {
  font-size: 22rpx;
  color: var(--gold-deep);
}
