.container { padding: 0 24rpx; }

/* 搜索框 */
.search-bar {
  padding: 20rpx 0 16rpx;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background: var(--paper);
  border: 1rpx solid var(--gold-mist);
  border-radius: 999rpx;
  padding: 16rpx 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(20, 73, 60, 0.08);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
}

.search-placeholder {
  color: var(--ink-mute);
}

.search-clear {
  font-size: 36rpx;
  color: var(--ink-mute);
  padding: 0 8rpx;
  line-height: 1;
}

/* 海报轮播 */
.poster-swiper {
  width: 100%;
  height: 340rpx;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
  box-shadow: 0 6rpx 24rpx rgba(20, 73, 60, 0.10);
}

.poster-img {
  width: 100%;
  height: 340rpx;
}

/* 筛选栏 */
.filter-bar {
  padding: 14rpx 0;
}

.filter-item {
  transition: background .2s;
}

.cat-list { padding-top: 4rpx; }

.cat-item {
  display: flex;
  padding: 24rpx;
}

.cat-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
  border: 1rpx solid var(--gold-mist);
}

.cat-content {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.cat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.cat-name {
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: var(--brand);
}

.cat-detail {
  font-size: 24rpx;
  color: var(--ink-mute);
  margin-top: 8rpx;
}

.cat-desc {
  font-size: 24rpx;
  color: var(--ink-soft);
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.cat-footer {
  display: flex;
  gap: 24rpx;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--gold-mist);
}

.cat-views, .cat-likes {
  font-size: 22rpx;
  color: var(--ink-mute);
}

.cat-item-focused {
  border: 2rpx solid var(--gold);
  box-shadow: 0 6rpx 20rpx var(--gold-mist);
}

.focus-hint {
  font-size: 22rpx;
  color: var(--gold-deep);
}
