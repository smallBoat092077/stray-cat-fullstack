.container { padding: 24rpx; }

.filter-bar {
  padding: 14rpx;
}

.filter-item {
  transition: background .2s;
}

.cat-list { padding-top: 4rpx; }

.cat-item {
  display: flex;
  padding: 24rpx;
}

.cat-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
  border: 1rpx solid var(--gold-mist);
}

.cat-content {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.cat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.cat-name {
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: var(--brand);
}

.cat-detail {
  font-size: 24rpx;
  color: var(--ink-mute);
  margin-top: 8rpx;
}

.cat-desc {
  font-size: 24rpx;
  color: var(--ink-soft);
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.cat-footer {
  display: flex;
  gap: 24rpx;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--gold-mist);
}

.cat-views, .cat-likes {
  font-size: 22rpx;
  color: var(--ink-mute);
}

.cat-item-focused {
  border: 2rpx solid var(--gold);
  box-shadow: 0 6rpx 20rpx var(--gold-mist);
}

.focus-hint {
  font-size: 22rpx;
  color: var(--gold-deep);
}
