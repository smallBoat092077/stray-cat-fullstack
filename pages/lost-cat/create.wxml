<brand-nav back="{{true}}" />
<view class="container">
  <view class="card">
    <text class="section-title">发布寻猫启事</text>
    <text class="form-hint">信息将先经审核再展示到广场；联系方式默认通过站内消息触达。</text>

    <view class="form-item">
      <text class="form-label">猫咪名字</text>
      <input class="form-input" placeholder="如：团子" value="{{catName}}" bindinput="onNameInput" />
    </view>

    <view class="form-item">
      <text class="form-label">毛色 / 花纹描述</text>
      <textarea class="form-textarea" placeholder="如：橘白相间，额头有 M 形花纹，尾巴有一圈深色环"
                maxlength="200" value="{{coatDesc}}" bindinput="onCoatInput" />
    </view>

    <view class="form-item">
      <text class="form-label">猫咪照片（最多 6 张）</text>
      <view class="image-list">
        <view class="image-item" wx:for="{{images}}" wx:key="index">
          <image src="{{item}}" mode="aspectFill" data-src="{{item}}" bindtap="previewImage" />
          <view class="image-remove" data-index="{{index}}" bindtap="removeImage">×</view>
        </view>
        <view class="image-add" wx:if="{{images.length < 6}}" bindtap="chooseImage">
          <text class="add-icon">+</text>
          <text class="add-text">添加照片</text>
        </view>
      </view>
      <text class="form-hint">已选 {{images.length}}/6 张</text>
    </view>

    <view class="form-item">
      <text class="form-label">丢失时间</text>
      <view class="datetime-row">
        <picker mode="date" value="{{lostDate}}" bindchange="onDateChange">
          <view class="form-value">{{lostDate}}</view>
        </picker>
        <picker mode="time" value="{{lostTime}}" bindchange="onTimeChange">
          <view class="form-value">{{lostTime}}</view>
        </picker>
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">丢失地点</text>
      <view class="location-picker" bindtap="chooseLocation">
        <text class="location-icon">📍</text>
        <text class="location-text">{{addressDesc || '点击在地图上选择丢失地点'}}</text>
        <text class="location-arrow">›</text>
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">联系方式</text>
      <view class="way-row">
        <view class="way-chip {{contactWay === 'inapp' ? 'active' : ''}}"
              data-way="inapp" bindtap="onContactWay">站内消息（推荐）</view>
        <view class="way-chip {{contactWay === 'phone' ? 'active' : ''}}"
              data-way="phone" bindtap="onContactWay">电话</view>
      </view>
      <input wx:if="{{contactWay === 'phone'}}" class="form-input" placeholder="填写手机号，审核通过后展示"
             value="{{contactValue}}" bindinput="onContactInput" />
      <text class="form-hint" wx:else>线索将通过站内消息通知你，不公开个人联系方式。</text>
    </view>

    <button class="btn-primary" style="margin-top: 40rpx;" bindtap="onSubmit" disabled="{{uploading}}">
      {{uploading ? '提交中...' : '提交审核'}}
    </button>
  </view>
</view>
