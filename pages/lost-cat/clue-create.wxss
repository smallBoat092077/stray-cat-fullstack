.form-hint {
  display: block;
  font-size: 22rpx;
  color: var(--ink-mute);
  line-height: 1.6;
  margin-top: 8rpx;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 12rpx 0;
}

.image-item, .image-add {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.image-item image {
  width: 100%;
  height: 100%;
}

.image-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(244, 239, 227, 0.7);
  border: 1rpx dashed var(--gold);
}

.add-icon { font-size: 48rpx; color: var(--gold-deep); line-height: 1; }
.add-text { margin-top: 8rpx; font-size: 22rpx; color: var(--ink-mute); }

.image-remove {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 0 0 0 12rpx;
  background: rgba(12, 51, 41, 0.75);
  color: #FFFDF7;
  font-size: 28rpx;
  text-align: center;
  line-height: 40rpx;
}

.datetime-row {
  display: flex;
  gap: 24rpx;
}

.datetime-row picker { flex: 1; }

.datetime-row .form-value {
  padding: 16rpx 20rpx;
  background: rgba(244, 239, 227, 0.55);
  border: 1rpx solid var(--gold-mist);
  border-radius: 8rpx;
  text-align: center;
}

.location-picker {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: rgba(244, 239, 227, 0.55);
  border: 1rpx solid var(--gold-mist);
  border-radius: 10rpx;
}

.location-icon { font-size: 32rpx; margin-right: 12rpx; }

.location-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.location-arrow { font-size: 32rpx; color: var(--gold-deep); }
