.mine-card {
  display: flex;
  align-items: stretch;
  padding: 20rpx;
}

.mine-cover {
  width: 170rpx;
  height: 170rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: var(--cream);
}

.mine-cover-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  border: 1rpx solid var(--gold-mist);
}

.mine-body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.mine-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mine-name {
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--brand);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mine-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-mute);
}

.mine-remark {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--gold-deep);
  line-height: 1.5;
}

.mine-remark-danger { color: var(--brick); }

.found-btn {
  align-self: flex-start;
  margin: 12rpx 0 0;
  padding: 6rpx 22rpx;
  font-size: 22rpx;
  line-height: 1.8;
  color: var(--brand);
  background: var(--paper);
  border: 1rpx solid var(--gold);
  border-radius: 999rpx;
}

.found-btn::after { border: none; }

/* 空状态 —— 本页局部覆盖全局 .empty：纵向四层，避免文案与按钮被排进同一行 */
.empty.empty-quiet {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 120rpx 24rpx 0;
  color: var(--ink-soft);
  box-sizing: border-box;
}

/* 淡薄荷圆底 + 纯 CSS 单枚爪印，取代突兀的紫色 emoji */
.empty-quiet .empty-art {
  width: 176rpx;
  height: 176rpx;
  margin-bottom: 36rpx;
  border-radius: 50%;
  background: rgba(227, 239, 222, 0.75);
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-quiet .paw {
  position: relative;
  width: 76rpx;
  height: 72rpx;
}

.empty-quiet .paw-toe {
  position: absolute;
  width: 18rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #9DBBA9;
}

.empty-quiet .toe-1 { left: 0; top: 14rpx; transform: rotate(-18deg); }
.empty-quiet .toe-2 { left: 20rpx; top: 2rpx; transform: rotate(-6deg); }
.empty-quiet .toe-3 { left: 40rpx; top: 2rpx; transform: rotate(6deg); }
.empty-quiet .toe-4 { left: 58rpx; top: 14rpx; transform: rotate(18deg); }

.empty-quiet .paw-pad {
  position: absolute;
  left: 16rpx;
  top: 30rpx;
  width: 44rpx;
  height: 38rpx;
  border-radius: 50% 50% 45% 45%;
  background: #9DBBA9;
}

.empty-quiet .empty-title {
  font-size: 30rpx;
  line-height: 1.6;
  letter-spacing: 1rpx;
  color: var(--ink-soft);
}

.empty-quiet .empty-desc {
  margin-top: 12rpx;
  max-width: 480rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--ink-mute);
}

/* 轻描边胶囊按钮：去实心深绿 / 重阴影 / 大字距，宽度固定不挤压文案 */
.empty-quiet .empty-btn {
  margin: 48rpx auto 0;
  padding: 0;
  width: 420rpx;
  height: 84rpx;
  line-height: 84rpx;
  box-sizing: border-box;
  background: var(--paper);
  color: var(--brand);
  border: 1rpx solid rgba(195, 161, 95, 0.75);
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 400;
  letter-spacing: 1rpx;
  box-shadow: none;
}

.empty-quiet .empty-btn::after { border: none; }
