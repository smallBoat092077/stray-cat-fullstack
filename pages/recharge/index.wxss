.container {
  padding: 24rpx 24rpx 60rpx;
}

.wallet {
  display: flex;
  flex-direction: column;
  padding: 32rpx 28rpx;
}

.wallet-label {
  font-size: 24rpx;
  color: var(--ink-mute);
}

.wallet-value {
  margin-top: 10rpx;
  font-size: 52rpx;
  font-weight: 600;
  color: var(--brand);
}

.wallet-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--ink-mute);
}

.pack-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pack-info {
  display: flex;
  flex-direction: column;
}

.pack-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
  font-family: "Songti SC", serif;
  letter-spacing: 2rpx;
}

.pack-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--ink-mute);
}

.pack-right {
  display: flex;
  align-items: center;
}

.pack-price {
  margin-right: 20rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--gold-deep);
}

.pack-btn {
  margin: 0;
  padding: 0 28rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
}

.notice {
  margin: 28rpx 8rpx 0;
}

.notice-title {
  display: block;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--brand);
}

.notice-item {
  display: block;
  font-size: 24rpx;
  line-height: 1.8;
  color: var(--ink-soft);
}

.notice-link {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--gold-deep);
  text-decoration: underline;
}
