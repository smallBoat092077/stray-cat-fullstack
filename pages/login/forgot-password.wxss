.container {
  padding: 24rpx 32rpx 64rpx;
  box-sizing: border-box;
}

/* 顶部提示条：米黄底 + 细金边 */
.notice {
  font-size: 24rpx;
  line-height: 1.75;
  color: #6B5B3E;
  background: linear-gradient(160deg, var(--sand) 0%, #F4ECD6 100%);
  border: 1rpx solid var(--gold-mist);
  border-radius: 12rpx;
  padding: 20rpx 22rpx;
  margin-bottom: 24rpx;
}

.form-card {
  padding: 32rpx 28rpx 12rpx;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: var(--ink-mute);
  margin: 8rpx 4rpx 0;
}

.foot-note {
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--ink-mute);
  margin: 20rpx 4rpx 0;
}

.submit-btn {
  width: 100%;
  margin-top: 36rpx;
}

.submit-btn.disabled {
  opacity: 0.6;
}

/* 结果态 */
.result {
  padding: 60rpx 24rpx 0;
  text-align: center;
}

.result-ok {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--mist);
  color: #3E7A63;
  font-size: 56rpx;
  line-height: 112rpx;
  text-align: center;
  margin: 0 auto 28rpx;
  border: 2rpx solid rgba(62, 122, 99, 0.25);
}

.result-title {
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--brand);
  letter-spacing: 4rpx;
  margin-bottom: 20rpx;
}

.result-desc {
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--ink-soft);
}

.result-tip {
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--ink-mute);
  margin-top: 16rpx;
}
