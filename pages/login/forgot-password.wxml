<brand-nav back="{{true}}" />
<view class="container">

  <!-- 申请态 -->
  <block wx:if="{{!submitted}}">
    <view class="section-title">密码找回申请</view>

    <view class="notice">
      密码由系统加密保存，无法查看原密码。提交申请后，管理员会核实身份并重置，通过你预留的手机号联系你。
    </view>

    <view class="card form-card">
      <view class="form-item">
        <text class="form-label">账号 *</text>
        <input class="form-input" placeholder="请输入注册账号" value="{{form.username}}"
               data-field="username" bindinput="onFieldInput" />
      </view>
      <view class="form-item">
        <text class="form-label">昵称 *</text>
        <input class="form-input" placeholder="请输入账号昵称" value="{{form.nickname}}"
               data-field="nickname" bindinput="onFieldInput" />
      </view>
      <view class="form-item">
        <text class="form-label">手机号 *</text>
        <input class="form-input" type="number" maxlength="11" placeholder="用于接收管理员来电"
               value="{{form.phone}}" data-field="phone" bindinput="onFieldInput" />
      </view>
      <view class="form-item">
        <text class="form-label">情况说明</text>
        <textarea class="form-textarea" placeholder="选填，≤200字" maxlength="200"
                  value="{{form.reason}}" data-field="reason" bindinput="onFieldInput" />
        <text class="char-count">{{form.reason.length}}/200</text>
      </view>
    </view>

    <view class="foot-note">请确保账号与昵称准确、手机号可接通，否则管理员无法核实与联系。</view>

    <button class="btn-primary submit-btn {{submitting ? 'disabled' : ''}}" bindtap="submit" disabled="{{submitting}}">
      {{submitting ? '提交中...' : '提交申请'}}
    </button>
  </block>

  <!-- 结果态 -->
  <view class="result" wx:else>
    <view class="result-ok">✓</view>
    <view class="result-title">申请已提交</view>
    <view class="result-desc">管理员会尽快核实身份并重置密码，请留意 {{phoneMasked}} 的来电。</view>
    <view class="result-tip">如长时间未收到，可稍后重新提交。</view>
    <button class="btn-primary submit-btn" bindtap="goLogin">返回登录</button>
  </view>

</view>
