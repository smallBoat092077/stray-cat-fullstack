.container {
  padding: 24rpx 32rpx 64rpx;
  box-sizing: border-box;
}

.notice {
  font-size: 24rpx;
  line-height: 1.75;
  color: #6B5B3E;
  background: linear-gradient(160deg, var(--sand) 0%, #F4ECD6 100%);
  border: 1rpx solid var(--gold-mist);
  border-radius: 12rpx;
  padding: 20rpx 22rpx;
  margin-bottom: 24rpx;
}

.form-card {
  padding: 32rpx 28rpx 12rpx;
}

.form-item { margin-bottom: 28rpx; }
.form-item.last { margin-bottom: 0; }

.input-row {
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid var(--gold-mist);
}

.row-input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--ink);
  padding: 18rpx 0;
}

.toggle {
  padding: 12rpx 0 12rpx 24rpx;
  font-size: 24rpx;
  color: var(--gold-deep);
}

.submit-btn {
  width: 100%;
  margin-top: 36rpx;
}

.submit-btn.disabled { opacity: 0.6; }

.foot-note {
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--ink-mute);
  margin: 24rpx 4rpx 0;
}
