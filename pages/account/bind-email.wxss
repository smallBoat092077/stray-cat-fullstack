.container {
  padding: 24rpx 32rpx 64rpx;
  box-sizing: border-box;
}

.notice {
  font-size: 24rpx;
  line-height: 1.75;
  color: #6B5B3E;
  background: linear-gradient(160deg, var(--sand) 0%, #F4ECD6 100%);
  border: 1rpx solid var(--gold-mist);
  border-radius: 12rpx;
  padding: 20rpx 22rpx;
  margin-bottom: 24rpx;
}

.notice-bad {
  color: var(--brick);
  background: rgba(168, 69, 59, 0.06);
  border-color: rgba(168, 69, 59, 0.22);
}

.info-card {
  padding: 8rpx 28rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--gold-mist);
}

.info-row.last { border-bottom: none; }

.info-label {
  font-size: 28rpx;
  color: var(--ink);
}

.info-value {
  font-size: 26rpx;
  color: var(--ink-soft);
}

.info-value.ok { color: #3E7A63; }

.form-card {
  padding: 32rpx 28rpx 12rpx;
}

.form-item { margin-bottom: 28rpx; }
.form-item.last { margin-bottom: 0; }

.code-row {
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid var(--gold-mist);
}

.code-input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--ink);
  padding: 18rpx 0;
}

.code-btn {
  flex: none;
  margin-left: 16rpx;
  padding: 12rpx 20rpx;
  border: 1rpx solid var(--gold);
  border-radius: 8rpx;
  background: var(--paper);
  color: var(--brand);
  font-size: 24rpx;
  white-space: nowrap;
}

.code-btn.disabled {
  color: var(--ink-mute);
  background: var(--cream);
  border-color: var(--gold-mist);
}

.act-btn {
  width: 100%;
  margin-top: 20rpx;
}

.btn-ghost {
  background: var(--paper);
  color: var(--brand);
  border: 2rpx solid var(--gold);
  border-radius: 8rpx;
  padding: 20rpx 46rpx;
  font-size: 30rpx;
  letter-spacing: 4rpx;
}

.btn-ghost::after { border: none; }

.btn-ghost.danger-line {
  color: var(--brick);
  border-color: rgba(168, 69, 59, 0.4);
}

.foot-note {
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--ink-mute);
  margin: 24rpx 4rpx 0;
}
