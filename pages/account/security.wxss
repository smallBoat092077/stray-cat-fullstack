.container {
  padding: 24rpx 32rpx 64rpx;
  box-sizing: border-box;
}

.sec-head {
  padding: 32rpx 28rpx;
}

.acc {
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--brand);
  letter-spacing: 2rpx;
}

.sub {
  font-size: 24rpx;
  color: var(--ink-mute);
  margin-top: 8rpx;
}

.state {
  display: inline-block;
  margin-top: 18rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.state-ok {
  color: #3E7A63;
  background: rgba(62, 122, 99, 0.12);
  border: 1rpx solid rgba(62, 122, 99, 0.28);
}

.state-warn {
  color: #8A6A2F;
  background: rgba(195, 161, 95, 0.16);
  border: 1rpx solid rgba(195, 161, 95, 0.42);
}

.state-bad {
  color: var(--brick);
  background: rgba(168, 69, 59, 0.12);
  border: 1rpx solid rgba(168, 69, 59, 0.30);
}

.notice {
  font-size: 24rpx;
  line-height: 1.75;
  color: #6B5B3E;
  background: linear-gradient(160deg, var(--sand) 0%, #F4ECD6 100%);
  border: 1rpx solid var(--gold-mist);
  border-radius: 12rpx;
  padding: 20rpx 22rpx;
  margin-bottom: 24rpx;
}

.notice-warn { color: #8A6A2F; }

.notice-bad {
  color: var(--brick);
  background: rgba(168, 69, 59, 0.06);
  border-color: rgba(168, 69, 59, 0.22);
}

.info-card {
  padding: 8rpx 28rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--gold-mist);
}

.info-row.last { border-bottom: none; }

.info-label {
  font-size: 28rpx;
  color: var(--ink);
}

.info-value {
  font-size: 26rpx;
  color: var(--ink-soft);
}

.info-value.muted { color: var(--brick); }

.action-list { margin-top: 32rpx; }

.act-btn {
  width: 100%;
  margin-top: 20rpx;
}

.btn-ghost {
  background: var(--paper);
  color: var(--brand);
  border: 2rpx solid var(--gold);
  border-radius: 8rpx;
  padding: 20rpx 46rpx;
  font-size: 30rpx;
  letter-spacing: 4rpx;
}

.btn-ghost::after { border: none; }

.btn-ghost.danger-line {
  color: var(--brick);
  border-color: rgba(168, 69, 59, 0.4);
}

.foot-note {
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--ink-mute);
  margin: 28rpx 4rpx 0;
}
