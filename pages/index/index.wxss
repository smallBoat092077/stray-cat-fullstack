.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 0;
}

.map {
  flex: 1;
  width: 100%;
}

.map-controls {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
}

.control-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.control-icon {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 8rpx;
}

.control-btn cover-text {
  font-size: 20rpx;
  color: #666;
}

/* 底部弹窗 */
.bottom-sheet {
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 24rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.sheet-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.sheet-more {
  font-size: 26rpx;
  color: #FF6B6B;
}

.cat-scroll {
  white-space: nowrap;
}

.cat-card {
  display: inline-flex;
  flex-direction: column;
  width: 240rpx;
  margin-right: 20rpx;
  background: #f8f8f8;
  border-radius: 16rpx;
  overflow: hidden;
  vertical-align: top;
}

.cat-avatar {
  width: 240rpx;
  height: 240rpx;
}

.cat-info {
  padding: 16rpx;
}

.cat-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.cat-tags {
  margin-bottom: 8rpx;
}

.cat-location {
  font-size: 22rpx;
  color: #999;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
